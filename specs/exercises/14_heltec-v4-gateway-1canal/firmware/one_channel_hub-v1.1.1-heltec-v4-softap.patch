+#ifndef _WIFI_PORTAL_H
+#define _WIFI_PORTAL_H
+
+/* -------------------------------------------------------------------------- */
+/* --- DEPENDENCIES --------------------------------------------------------- */
+
+#include <stdbool.h>
+#include <stddef.h>
+
+/* -------------------------------------------------------------------------- */
+/* --- PUBLIC CONSTANTS ----------------------------------------------------- */
+
+#define WIFI_SSID_STR_MAX_SIZE ( 32 + 1 )
+#define WIFI_PASSWORD_STR_MAX_SIZE ( 64 + 1 )
+
+/* -------------------------------------------------------------------------- */
+/* --- PUBLIC FUNCTIONS PROTOTYPES ------------------------------------------ */
+
+/**
+ * @brief Get the WiFi credentials saved in NVS
+ *
+ * @returns true if an SSID is configured
+ */
+bool wifi_portal_get_credentials( char ssid[WIFI_SSID_STR_MAX_SIZE], char password[WIFI_PASSWORD_STR_MAX_SIZE] );
+
+/**
+ * @brief Request the portal to be opened at next startup (used when the configured WiFi cannot be joined)
+ */
+void wifi_portal_request_at_next_boot( void );
+
+/**
+ * @brief Check (and clear) a portal request made before the last reset
+ */
+bool wifi_portal_requested( void );
+
+/**
+ * @brief Open the WiFi access point and the configuration page. Never returns: the ESP32 restarts once the
+ * configuration is saved, or after timeout_s seconds without any submission (0 for no timeout).
+ *
+ * esp_netif_init() and nvs_flash_init() must have been called before.
+ */
+void wifi_portal_run( unsigned int timeout_s );
+
+#endif  // _WIFI_PORTAL_H
+
+/* --- EOF ------------------------------------------------------------------ */
