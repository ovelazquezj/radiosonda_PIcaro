# Heltec WiFi LoRa 32 v4 - US915 sub-band 2, one channel, configuration portal over WiFi (SoftAP)
# Use on top of sdkconfig.defaults:
#   idf.py -B build_heltec_v4 -D SDKCONFIG=sdkconfig.heltec_v4 -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.heltec_v4" build
CONFIG_HELTEC_WIFI_LORA_32_V4=y
CONFIG_RADIO_TYPE_SX1262=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_BT_ENABLED=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# CONFIG_WIFI_PROV_OVER_BLE is not set
CONFIG_WIFI_PROV_SOFTAP=y
CONFIG_WIFI_PORTAL_AP_PREFIX="PiCARO-GW-"
CONFIG_WIFI_PORTAL_AP_PASSWORD="picaro1234"
CONFIG_WIFI_PORTAL_DELAY_S=5
CONFIG_NETWORK_SERVER_ADDRESS=""
CONFIG_NETWORK_SERVER_PORT=1700
CONFIG_CHANNEL_FREQ_HZ=903900000
CONFIG_CHANNEL_LORA_SPREADING_FACTOR_1=10
CONFIG_CHANNEL_LORA_SPREADING_FACTOR_2=0
CONFIG_CHANNEL_LORA_BANDWIDTH=125
