--- /dev/null
+++ b/lorahub/main/wifi_portal.c
@@ -0,0 +1,678 @@
+/*______                              _
+ / _____)             _              | |
+( (____  _____ ____ _| |_ _____  ____| |__
+ \____ \| ___ |    (_   _) ___ |/ ___)  _ \
+ _____) ) ____| | | || |_| ____( (___| | | |
+(______/|_____)_|_|_| \__)_____)\____)_| |_|
+  (C)2024 Semtech
+
+Description:
+    LoRaHub WiFi configuration portal (SoftAP + web page)
+
+    The gateway opens its own access point. A DNS server answers every name with the gateway address, so
+    phones and laptops open the configuration page by themselves (captive portal). The page saves the WiFi
+    credentials, the LoRaWAN network server address/port and the channel in NVS, then restarts.
+
+License: Revised BSD License, see LICENSE.TXT file include in the project
+*/
+
+/* -------------------------------------------------------------------------- */
+/* --- DEPENDENCIES --------------------------------------------------------- */
+
+#include <string.h>
+#include <stdlib.h>
+#include <ctype.h>
+
+#include <unistd.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+
+#include <esp_log.h>
+#include <esp_wifi.h>
+#include <esp_netif.h>
+#include <esp_mac.h>
+#include <esp_attr.h>
+#include <esp_timer.h>
+#include <esp_http_server.h>
+#include <nvs_flash.h>
+
+#include "wifi_portal.h"
+#include "config_nvs.h"
+#include "display.h"
+
+/* -------------------------------------------------------------------------- */
+/* --- PRIVATE CONSTANTS ---------------------------------------------------- */
+
+#define NVS_NAMESPACE "storage"
+#define NVS_KEY_WIFI_SSID "wifi_ssid"
+#define NVS_KEY_WIFI_PASSWORD "wifi_pass"
+
+#define PORTAL_REQUEST_MAGIC 0x504F5254 /* "PORT" */
+
+#define PORTAL_IP_STR "192.168.4.1"
+#define PORTAL_URL "http://" PORTAL_IP_STR "/"
+
+#define SCAN_LIST_MAX_SIZE 20
+#define FORM_BODY_MAX_SIZE 512
+#define FORM_VALUE_MAX_SIZE 96
+
+#define DNS_PORT 53
+#define DNS_BUFFER_SIZE 512
+
+static const char* TAG_PORTAL = "portal";
+
+static const char html_header[] =
+    "<!DOCTYPE html><html><head><meta charset=\"utf-8\">"
+    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">"
+    "<title>LoRaHub - configuracion</title>"
+    "<style>"
+    "body{font-family:sans-serif;margin:0;padding:16px;background:#f4f6f8;color:#1d2733}"
+    "main{max-width:420px;margin:auto;background:#fff;border-radius:8px;padding:16px 20px}"
+    "h1{font-size:1.3em;margin:0 0 4px}h2{font-size:1.05em;margin:20px 0 6px;color:#2a5d8f}"
+    "p.id{margin:0;color:#5a6773;font-size:.9em}"
+    "label{display:block;margin-top:10px;font-size:.9em}"
+    "input,select{width:100%;box-sizing:border-box;padding:8px;margin-top:3px;font-size:1em;"
+    "border:1px solid #b9c3cc;border-radius:4px}"
+    "button{width:100%;margin-top:20px;padding:10px;font-size:1em;border:0;border-radius:4px;"
+    "background:#2a5d8f;color:#fff}"
+    ".err{color:#b3261e}.ok{color:#1e7b34}"
+    "</style></head><body><main>";
+
+static const char html_footer[] = "</main></body></html>";
+
+/* -------------------------------------------------------------------------- */
+/* --- PRIVATE VARIABLES ---------------------------------------------------- */
+
+/* Survives a software reset, not a power cycle */
+static RTC_NOINIT_ATTR uint32_t portal_request;
+
+static char ap_ssid[WIFI_SSID_STR_MAX_SIZE] = { 0 };
+
+static char     scan_ssids[SCAN_LIST_MAX_SIZE][WIFI_SSID_STR_MAX_SIZE];
+static uint16_t scan_count = 0;
+
+static volatile bool    config_saved          = false;
+static volatile int64_t last_activity_time_us = 0;
+
+/* -------------------------------------------------------------------------- */
+/* --- PRIVATE FUNCTIONS DEFINITION ----------------------------------------- */
+
+static esp_err_t save_credentials( const char* ssid, const char* password )
+{
+    nvs_handle_t handle;
+    esp_err_t    err = nvs_open( NVS_NAMESPACE, NVS_READWRITE, &handle );
+    if( err != ESP_OK )
+    {
+        return err;
+    }
+    err = nvs_set_str( handle, NVS_KEY_WIFI_SSID, ssid );
+    if( err == ESP_OK )
+    {
+        err = nvs_set_str( handle, NVS_KEY_WIFI_PASSWORD, password );
+    }
+    if( err == ESP_OK )
+    {
+        err = nvs_commit( handle );
+    }
+    nvs_close( handle );
+    return err;
+}
+
+/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
+
+static void url_decode( char* str )
+{
+    char* src = str;
+    char* dst = str;
+    while( *src != '\0' )
+    {
+        if( ( *src == '%' ) && isxdigit( ( unsigned char ) src[1] ) && isxdigit( ( unsigned char ) src[2] ) )
+        {
+            char hex[3] = { src[1], src[2], '\0' };
+            *dst++      = ( char ) strtol( hex, NULL, 16 );
+            src += 3;
+        }
+        else if( *src == '+' )
+        {
+            *dst++ = ' ';
+            src++;
+        }
+        else
+        {
+            *dst++ = *src++;
+        }
+    }
+    *dst = '\0';
+}
+
+/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
+
+static bool get_form_value( const char* body, const char* key, char* value, size_t size )
+{
+    if( httpd_query_key_value( body, key, value, size ) != ESP_OK )
+    {
+        value[0] = '\0';
+        return false;
+    }
+    url_decode( value );
+    return true;
+}
+
+/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
+
+/* Send a string with the HTML special characters escaped */
+static void send_escaped( httpd_req_t* req, const char* str )
+{
+    char   buf[64];
+    size_t n = 0;
+    for( const char* p = str; *p != '\0'; p++ )
+    {
+        const char* rep = NULL;
+        switch( *p )
+        {
+        case '&':
+            rep = "&amp;";
+            break;
+        case '<':
+            rep = "&lt;";
+            break;
+        case '>':
+            rep = "&gt;";
+            break;
+        case '"':
+            rep = "&quot;";
+            break;
+        case '\'':
+            rep = "&#39;";
+            break;
+        default:
+            break;
+        }
+        size_t len = ( rep != NULL ) ? strlen( rep ) : 1;
+        if( n + len >= sizeof buf )
+        {
+            buf[n] = '\0';
+            httpd_resp_sendstr_chunk( req, buf );
+            n = 0;
+        }
+        if( rep != NULL )
+        {
+            memcpy( &buf[n], rep, len );
+        }
+        else
+        {
+            buf[n] = *p;
+        }
+        n += len;
+    }
+    /* never send an empty chunk: it would terminate the chunked response */
+    if( n > 0 )
+    {
+        buf[n] = '\0';
+        httpd_resp_sendstr_chunk( req, buf );
+    }
+}
+
+/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
+
+static void send_form( httpd_req_t* req, const char* message, bool is_error )
+{
+    char ssid[WIFI_SSID_STR_MAX_SIZE];
+    char password[WIFI_PASSWORD_STR_MAX_SIZE];
+    char buf[160];
+
+    const lgw_nvs_cfg_t* cfg;
+    lgw_nvs_get_config( &cfg );
+    wifi_portal_get_credentials( ssid, password );
+
+    httpd_resp_set_type( req, "text/html" );
+    httpd_resp_sendstr_chunk( req, html_header );
+
+    httpd_resp_sendstr_chunk( req, "<h1>LoRaHub - configuracion</h1><p class=\"id\">" );
+    send_escaped( req, ap_ssid );
+    httpd_resp_sendstr_chunk( req, "</p>" );
+
+    if( message != NULL )
+    {
+        httpd_resp_sendstr_chunk( req, is_error ? "<p class=\"err\">" : "<p class=\"ok\">" );
+        send_escaped( req, message );
+        httpd_resp_sendstr_chunk( req, "</p>" );
+    }
+
+    httpd_resp_sendstr_chunk( req, "<form method=\"post\" action=\"/save\">" );
+
+    /* WiFi */
+    httpd_resp_sendstr_chunk( req, "<h2>Red WiFi local</h2>" );
+    if( scan_count > 0 )
+    {
+        /* networks found at startup: picking one fills the SSID field */
+        httpd_resp_sendstr_chunk( req, "<label for=\"redes\">Redes encontradas</label>"
+                                       "<select id=\"redes\" onchange=\"if(this.value)"
+                                       "document.getElementById('ssid').value=this.value\">"
+                                       "<option value=\"\">-- elige una red --</option>" );
+        for( uint16_t i = 0; i < scan_count; i++ )
+        {
+            httpd_resp_sendstr_chunk( req, "<option value=\"" );
+            send_escaped( req, scan_ssids[i] );
+            httpd_resp_sendstr_chunk( req, "\">" );
+            send_escaped( req, scan_ssids[i] );
+            httpd_resp_sendstr_chunk( req, "</option>" );
+        }
+        httpd_resp_sendstr_chunk( req, "</select>" );
+    }
+    httpd_resp_sendstr_chunk( req, "<label for=\"ssid\">Nombre de la red (SSID)</label>"
+                                   "<input id=\"ssid\" name=\"ssid\" maxlength=\"32\" required value=\"" );
+    send_escaped( req, ssid );
+    httpd_resp_sendstr_chunk( req, "\">" );
+    httpd_resp_sendstr_chunk( req, "<label for=\"pass\">Contrase&ntilde;a" );
+    if( strlen( ssid ) > 0 )
+    {
+        httpd_resp_sendstr_chunk( req, " (vac&iacute;a = conservar la guardada)" );
+    }
+    httpd_resp_sendstr_chunk( req, "</label><input id=\"pass\" name=\"pass\" type=\"password\" maxlength=\"64\">" );
+
+    /* LNS */
+    httpd_resp_sendstr_chunk( req, "<h2>Servidor LoRaWAN (LNS)</h2>" );
+    httpd_resp_sendstr_chunk( req, "<label for=\"lns\">IP o nombre del servidor</label>"
+                                   "<input id=\"lns\" name=\"lns\" maxlength=\"63\" required value=\"" );
+    send_escaped( req, cfg->lns_address );
+    httpd_resp_sendstr_chunk( req, "\">" );
+    snprintf( buf, sizeof buf,
+              "<label for=\"port\">Puerto UDP</label>"
+              "<input id=\"port\" name=\"port\" type=\"number\" min=\"1\" max=\"65535\" required value=\"%u\">",
+              cfg->lns_port );
+    httpd_resp_sendstr_chunk( req, buf );
+
+    /* Channel */
+    httpd_resp_sendstr_chunk( req, "<h2>Canal LoRa</h2>" );
+    snprintf( buf, sizeof buf,
+              "<label for=\"freq\">Frecuencia (Hz)</label>"
+              "<input id=\"freq\" name=\"freq\" type=\"number\" required value=\"%lu\">",
+              ( unsigned long ) cfg->chan_freq_hz );
+    httpd_resp_sendstr_chunk( req, buf );
+    httpd_resp_sendstr_chunk( req, "<label for=\"sf\">Spreading factor (BW 125 kHz)</label><select id=\"sf\" name=\"sf\">" );
+    for( int sf = 7; sf <= 12; sf++ )
+    {
+        snprintf( buf, sizeof buf, "<option value=\"%d\"%s>SF%d</option>", sf,
+                  ( sf == cfg->chan_datarate_1 ) ? " selected" : "", sf );
+        httpd_resp_sendstr_chunk( req, buf );
+    }
+    httpd_resp_sendstr_chunk( req, "</select>" );
+
+    httpd_resp_sendstr_chunk( req, "<button type=\"submit\">Guardar y reiniciar</button></form>" );
+    httpd_resp_sendstr_chunk( req, html_footer );
+    httpd_resp_sendstr_chunk( req, NULL );
+}
+
+/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
+
+static esp_err_t portal_root_get_handler( httpd_req_t* req )
+{
+    last_activity_time_us = esp_timer_get_time( );
+    send_form( req, NULL, false );
+    return ESP_OK;
+}
+
+/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
+
+static esp_err_t portal_save_post_handler( httpd_req_t* req )
+{
+    char body[FORM_BODY_MAX_SIZE];
+    char ssid[FORM_VALUE_MAX_SIZE];
+    char password[FORM_VALUE_MAX_SIZE];
+    char lns[FORM_VALUE_MAX_SIZE];
+    char value[FORM_VALUE_MAX_SIZE];
+
+    last_activity_time_us = esp_timer_get_time( );
+
+    if( req->content_len >= sizeof body )
+    {
+        send_form( req, "Formulario demasiado largo.", true );
+        return ESP_OK;
+    }
+    int received = 0;
+    while( received < req->content_len )
+    {
+        int ret = httpd_req_recv( req, body + received, req->content_len - received );
+        if( ret <= 0 )
+        {
+            if( ret == HTTPD_SOCK_ERR_TIMEOUT )
+            {
+                continue;
+            }
+            return ESP_FAIL;
+        }
+        received += ret;
+    }
+    body[received] = '\0';
+
+    /* WiFi credentials */
+    get_form_value( body, "ssid", ssid, sizeof ssid );
+    get_form_value( body, "pass", password, sizeof password );
+    if( ( strlen( ssid ) == 0 ) || ( strlen( ssid ) > 32 ) )
+    {
+        send_form( req, "El nombre de la red debe tener de 1 a 32 caracteres.", true );
+        return ESP_OK;
+    }
+    if( strlen( password ) == 0 )
+    {
+        /* keep the saved password if the network is the same */
+        char saved_ssid[WIFI_SSID_STR_MAX_SIZE];
+        char saved_password[WIFI_PASSWORD_STR_MAX_SIZE];
+        if( wifi_portal_get_credentials( saved_ssid, saved_password ) && ( strcmp( saved_ssid, ssid ) == 0 ) )
+        {
+            snprintf( password, sizeof password, "%s", saved_password );
+        }
+    }
+    else if( ( strlen( password ) < 8 ) || ( strlen( password ) > 63 ) )
+    {
+        send_form( req, "La contrasena WPA2 debe tener de 8 a 63 caracteres.", true );
+        return ESP_OK;
+    }
+
+    /* LNS and channel */
+    const lgw_nvs_cfg_t* current_cfg;
+    lgw_nvs_get_config( &current_cfg );
+    lgw_nvs_cfg_t cfg = *current_cfg;
+
+    get_form_value( body, "lns", lns, sizeof lns );
+    if( ( strlen( lns ) == 0 ) || ( strlen( lns ) >= LNS_ADDRESS_STR_MAX_SIZE ) )
+    {
+        send_form( req, "Indica la IP o el nombre del servidor LNS.", true );
+        return ESP_OK;
+    }
+    memcpy( cfg.lns_address, lns, strlen( lns ) + 1 ); /* length checked above */
+
+    get_form_value( body, "port", value, sizeof value );
+    long port = strtol( value, NULL, 10 );
+    if( ( port < 1 ) || ( port > 65535 ) )
+    {
+        send_form( req, "Puerto invalido (1-65535).", true );
+        return ESP_OK;
+    }
+    cfg.lns_port = ( uint16_t ) port;
+
+    get_form_value( body, "freq", value, sizeof value );
+    unsigned long freq = strtoul( value, NULL, 10 );
+    if( ( freq < 150000000UL ) || ( freq > 960000000UL ) )
+    {
+        send_form( req, "Frecuencia invalida (en Hz, p. ej. 903900000).", true );
+        return ESP_OK;
+    }
+    cfg.chan_freq_hz = ( uint32_t ) freq;
+
+    get_form_value( body, "sf", value, sizeof value );
+    long sf = strtol( value, NULL, 10 );
+    if( ( sf < 7 ) || ( sf > 12 ) )
+    {
+        send_form( req, "Spreading factor invalido (7-12).", true );
+        return ESP_OK;
+    }
+    cfg.chan_datarate_1    = ( uint8_t ) sf;
+    cfg.chan_bandwidth_khz = 125;
+
+    /* Save */
+    lgw_nvs_set_config( &cfg );
+    if( ( lgw_nvs_save_config( ) != ESP_OK ) || ( save_credentials( ssid, password ) != ESP_OK ) )
+    {
+        send_form( req, "No se pudo guardar la configuracion en la flash.", true );
+        return ESP_OK;
+    }
+    ESP_LOGI( TAG_PORTAL, "Configuration saved: WiFi \"%s\", LNS %s:%u, %lu Hz SF%u", ssid, cfg.lns_address,
+              cfg.lns_port, ( unsigned long ) cfg.chan_freq_hz, cfg.chan_datarate_1 );
+
+    httpd_resp_set_type( req, "text/html" );
+    httpd_resp_sendstr_chunk( req, html_header );
+    httpd_resp_sendstr_chunk( req, "<h1>Configuraci&oacute;n guardada</h1><p class=\"ok\">El gateway se reinicia y se "
+                                   "conecta a la red <b>" );
+    send_escaped( req, ssid );
+    httpd_resp_sendstr_chunk( req, "</b>. Esta red WiFi de configuraci&oacute;n desaparecer&aacute;.</p>" );
+    httpd_resp_sendstr_chunk( req, html_footer );
+    httpd_resp_sendstr_chunk( req, NULL );
+
+    config_saved = true;
+    return ESP_OK;
+}
+
+/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
+
+/* Any other URL (connectivity checks of phones and laptops) is redirected to the configuration page */
+static esp_err_t portal_redirect_handler( httpd_req_t* req )
+{
+    httpd_resp_set_status( req, "302 Found" );
+    httpd_resp_set_hdr( req, "Location", PORTAL_URL );
+    httpd_resp_send( req, NULL, 0 );
+    return ESP_OK;
+}
+
+/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
+
+/* Minimal DNS server: answers every A query with the portal address */
+static void dns_server_task( void* arg )
+{
+    uint8_t buf[DNS_BUFFER_SIZE];
+
+    int sock = socket( AF_INET, SOCK_DGRAM, IPPROTO_UDP );
+    if( sock < 0 )
+    {
+        ESP_LOGE( TAG_PORTAL, "DNS: socket failed" );
+        vTaskDelete( NULL );
+        return;
+    }
+    struct sockaddr_in addr = { .sin_family = AF_INET, .sin_port = htons( DNS_PORT ), .sin_addr.s_addr = 0 };
+    if( bind( sock, ( struct sockaddr* ) &addr, sizeof addr ) < 0 )
+    {
+        ESP_LOGE( TAG_PORTAL, "DNS: bind failed" );
+        close( sock );
+        vTaskDelete( NULL );
+        return;
+    }
+
+    esp_ip4_addr_t portal_ip;
+    esp_netif_str_to_ip4( PORTAL_IP_STR, &portal_ip );
+
+    while( true )
+    {
+        struct sockaddr_in client;
+        socklen_t          client_len = sizeof client;
+        int len = recvfrom( sock, buf, sizeof buf - 16, 0, ( struct sockaddr* ) &client, &client_len );
+        if( len < 12 )
+        {
+            continue;
+        }
+        /* only standard queries with one question */
+        if( ( ( buf[2] & 0x80 ) != 0 ) || ( buf[4] != 0 ) || ( buf[5] != 1 ) )
+        {
+            continue;
+        }
+        /* end of the question name */
+        int pos = 12;
+        while( ( pos < len ) && ( buf[pos] != 0 ) )
+        {
+            pos += buf[pos] + 1;
+        }
+        if( pos + 5 > len )
+        {
+            continue;
+        }
+        uint16_t qtype = ( buf[pos + 1] << 8 ) | buf[pos + 2];
+        pos += 5; /* null label + QTYPE + QCLASS */
+
+        buf[2] = 0x84 | ( buf[2] & 0x01 ); /* response, authoritative, keep RD */
+        buf[3] = 0x80;                     /* RA, no error */
+        buf[6] = 0;
+        buf[7] = ( qtype == 1 ) ? 1 : 0; /* ANCOUNT */
+        memset( &buf[8], 0, 4 );         /* NSCOUNT, ARCOUNT */
+        if( qtype == 1 )
+        {
+            const uint8_t answer[] = { 0xC0, 0x0C, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0x00, 0x3C, 0x00, 0x04 };
+            memcpy( &buf[pos], answer, sizeof answer );
+            pos += sizeof answer;
+            memcpy( &buf[pos], &portal_ip.addr, 4 );
+            pos += 4;
+        }
+        sendto( sock, buf, pos, 0, ( struct sockaddr* ) &client, client_len );
+    }
+}
+
+/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
+
+static void scan_networks( void )
+{
+    wifi_scan_config_t scan_cfg = { 0 };
+    if( esp_wifi_scan_start( &scan_cfg, true ) != ESP_OK )
+    {
+        ESP_LOGW( TAG_PORTAL, "WiFi scan failed" );
+        return;
+    }
+    uint16_t          nb      = SCAN_LIST_MAX_SIZE;
+    wifi_ap_record_t* records = calloc( SCAN_LIST_MAX_SIZE, sizeof( wifi_ap_record_t ) );
+    if( records == NULL )
+    {
+        esp_wifi_clear_ap_list( );
+        return;
+    }
+    if( esp_wifi_scan_get_ap_records( &nb, records ) != ESP_OK )
+    {
+        free( records );
+        return;
+    }
+    scan_count = 0;
+    for( uint16_t i = 0; i < nb; i++ )
+    {
+        const char* name = ( const char* ) records[i].ssid;
+        bool        dup  = ( strlen( name ) == 0 );
+        for( uint16_t j = 0; ( j < scan_count ) && !dup; j++ )
+        {
+            dup = ( strcmp( scan_ssids[j], name ) == 0 );
+        }
+        if( !dup )
+        {
+            snprintf( scan_ssids[scan_count++], WIFI_SSID_STR_MAX_SIZE, "%s", name );
+        }
+    }
+    free( records );
+    ESP_LOGI( TAG_PORTAL, "%u WiFi networks found", scan_count );
+}
+
+/* -------------------------------------------------------------------------- */
+/* --- PUBLIC FUNCTIONS DEFINITION ------------------------------------------ */
+
+bool wifi_portal_get_credentials( char ssid[WIFI_SSID_STR_MAX_SIZE], char password[WIFI_PASSWORD_STR_MAX_SIZE] )
+{
+    nvs_handle_t handle;
+    size_t       size;
+
+    ssid[0]     = '\0';
+    password[0] = '\0';
+    if( nvs_open( NVS_NAMESPACE, NVS_READONLY, &handle ) != ESP_OK )
+    {
+        return false;
+    }
+    size = WIFI_SSID_STR_MAX_SIZE;
+    if( nvs_get_str( handle, NVS_KEY_WIFI_SSID, ssid, &size ) != ESP_OK )
+    {
+        ssid[0] = '\0';
+    }
+    size = WIFI_PASSWORD_STR_MAX_SIZE;
+    if( nvs_get_str( handle, NVS_KEY_WIFI_PASSWORD, password, &size ) != ESP_OK )
+    {
+        password[0] = '\0';
+    }
+    nvs_close( handle );
+
+    return ( strlen( ssid ) > 0 );
+}
+
+/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
+
+void wifi_portal_request_at_next_boot( void )
+{
+    portal_request = PORTAL_REQUEST_MAGIC;
+}
+
+/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
+
+bool wifi_portal_requested( void )
+{
+    bool requested = ( portal_request == PORTAL_REQUEST_MAGIC );
+    portal_request = 0;
+    return requested;
+}
+
+/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
+
+void wifi_portal_run( unsigned int timeout_s )
+{
+    uint8_t mac[6];
+
+    ESP_ERROR_CHECK( esp_event_loop_create_default( ) );
+    esp_netif_create_default_wifi_ap( );
+    esp_netif_create_default_wifi_sta( ); /* for the scan */
+
+    wifi_init_config_t init_cfg = WIFI_INIT_CONFIG_DEFAULT( );
+    ESP_ERROR_CHECK( esp_wifi_init( &init_cfg ) );
+    ESP_ERROR_CHECK( esp_wifi_set_storage( WIFI_STORAGE_RAM ) );
+    ESP_ERROR_CHECK( esp_wifi_set_mode( WIFI_MODE_APSTA ) );
+
+    /* Same suffix as the gateway ID (station MAC address) */
+    esp_read_mac( mac, ESP_MAC_WIFI_STA );
+    snprintf( ap_ssid, sizeof ap_ssid, "%s%02X%02X%02X", CONFIG_WIFI_PORTAL_AP_PREFIX, mac[3], mac[4], mac[5] );
+
+    wifi_config_t ap_cfg = { .ap = { .channel = 1, .max_connection = 4 } };
+    ap_cfg.ap.ssid_len = strnlen( ap_ssid, sizeof ap_cfg.ap.ssid );
+    memcpy( ap_cfg.ap.ssid, ap_ssid, ap_cfg.ap.ssid_len );
+    if( strlen( CONFIG_WIFI_PORTAL_AP_PASSWORD ) >= 8 )
+    {
+        snprintf( ( char* ) ap_cfg.ap.password, sizeof ap_cfg.ap.password, "%s", CONFIG_WIFI_PORTAL_AP_PASSWORD );
+        ap_cfg.ap.authmode = WIFI_AUTH_WPA2_PSK;
+    }
+    else
+    {
+        ap_cfg.ap.authmode = WIFI_AUTH_OPEN;
+    }
+    ESP_ERROR_CHECK( esp_wifi_set_config( WIFI_IF_AP, &ap_cfg ) );
+    ESP_ERROR_CHECK( esp_wifi_start( ) );
+
+    scan_networks( );
+
+    ESP_LOGI( TAG_PORTAL, "Configuration portal: join WiFi \"%s\" and open %s", ap_ssid, PORTAL_URL );
+    display_update_portal_info( ap_ssid );
+    display_update_status( DISPLAY_STATUS_WIFI_PROVISIONING );
+
+    xTaskCreate( dns_server_task, "dns_server", 4096, NULL, 5, NULL );
+
+    httpd_handle_t server = NULL;
+    httpd_config_t config = HTTPD_DEFAULT_CONFIG( );
+    config.uri_match_fn   = httpd_uri_match_wildcard;
+    config.lru_purge_enable = true;
+    ESP_ERROR_CHECK( httpd_start( &server, &config ) );
+
+    const httpd_uri_t root_uri     = { .uri = "/", .method = HTTP_GET, .handler = portal_root_get_handler };
+    const httpd_uri_t save_uri     = { .uri = "/save", .method = HTTP_POST, .handler = portal_save_post_handler };
+    const httpd_uri_t redirect_uri = { .uri = "/*", .method = HTTP_GET, .handler = portal_redirect_handler };
+    httpd_register_uri_handler( server, &root_uri );
+    httpd_register_uri_handler( server, &save_uri );
+    httpd_register_uri_handler( server, &redirect_uri );
+
+    last_activity_time_us = esp_timer_get_time( );
+    while( !config_saved )
+    {
+        vTaskDelay( 1000 / portTICK_PERIOD_MS );
+        if( ( timeout_s > 0 ) &&
+            ( ( esp_timer_get_time( ) - last_activity_time_us ) > ( int64_t ) timeout_s * 1000000 ) )
+        {
+            ESP_LOGW( TAG_PORTAL, "No configuration received for %u s, restarting", timeout_s );
+            break;
+        }
+    }
+
+    /* let the browser receive the answer */
+    vTaskDelay( 2000 / portTICK_PERIOD_MS );
+    esp_restart( );
+}
+
+/* --- EOF ------------------------------------------------------------------ */
