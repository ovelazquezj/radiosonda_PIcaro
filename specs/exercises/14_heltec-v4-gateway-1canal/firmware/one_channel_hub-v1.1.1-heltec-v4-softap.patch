diff --git a/components/smtc_ral/bsp/sx126x/heltec_wifi_lora_32_v4.c b/components/smtc_ral/bsp/sx126x/heltec_wifi_lora_32_v4.c
new file mode 100644
index 0000000..6480bb1
--- /dev/null
+++ b/components/smtc_ral/bsp/sx126x/heltec_wifi_lora_32_v4.c
@@ -0,0 +1,184 @@
+/*!
+ * @file      heltec_wifi_lora_32_v4.c
+ *
+ * @brief     Interface specific to Heltec WiFi LoRa 32 v4 board.
+ *
+ * The Clear BSD License
+ * Copyright Semtech Corporation 2022. All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted (subject to the limitations in the disclaimer
+ * below) provided that the following conditions are met:
+ *     * Redistributions of source code must retain the above copyright
+ *       notice, this list of conditions and the following disclaimer.
+ *     * Redistributions in binary form must reproduce the above copyright
+ *       notice, this list of conditions and the following disclaimer in the
+ *       documentation and/or other materials provided with the distribution.
+ *     * Neither the name of the Semtech corporation nor the
+ *       names of its contributors may be used to endorse or promote products
+ *       derived from this software without specific prior written permission.
+ *
+ * NO EXPRESS OR IMPLIED LICENSES TO ANY PARTY'S PATENT RIGHTS ARE GRANTED BY
+ * THIS LICENSE. THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND
+ * CONTRIBUTORS "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT
+ * NOT LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A
+ * PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL SEMTECH CORPORATION BE
+ * LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+
+/*
+ * -----------------------------------------------------------------------------
+ * --- DEPENDENCIES ------------------------------------------------------------
+ */
+
+#include <stddef.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <driver/gpio.h>
+#include <esp_rom_sys.h>
+#include <esp_log.h>
+
+#include "smtc_shield_sx126x_types.h"
+#include "heltec_wifi_lora_32_v4.h"
+
+/*
+ * -----------------------------------------------------------------------------
+ * --- PRIVATE MACROS ----------------------------------------------------------
+ */
+
+/*
+ * -----------------------------------------------------------------------------
+ * --- PRIVATE CONSTANTS -------------------------------------------------------
+ */
+
+#define FEM_POWER_GPIO 7    /* VFEM_Ctrl: FEM LDO enable */
+#define FEM_ENABLE_GPIO 2   /* GC1109 CSD / KCT8103L CSD: chip enable (HIGH=on) */
+#define GC1109_CPS_GPIO 46  /* GC1109 CPS: HIGH=PA, LOW=bypass */
+#define KCT8103L_CTX_GPIO 5 /* KCT8103L CTX: HIGH=TX or RX bypass, LOW=RX through LNA */
+
+/* Gain of the FEM PA. The datasheets give 11 dB at low drive, down to 7 dB near saturation: 10 dB
+ * keeps the output close to the request without exceeding it at the levels used by downlinks. */
+#define FEM_PA_GAIN_DB 10
+
+/* Output power range at the antenna connector */
+#define HELTEC_V4_PWR_MIN ( SMTC_SHIELD_SX1262_MIN_PWR + FEM_PA_GAIN_DB )
+#define HELTEC_V4_PWR_MAX 27
+
+static const char* TAG_HELTEC_V4 = "HELTEC_V4";
+
+/**
+ * @brief XOSC configuration: TCXO driven by DIO3 at 1.8 V
+ */
+const smtc_shield_sx126x_xosc_cfg_t heltec_wifi_lora_32_v4_xosc_cfg = {
+    .tcxo_is_radio_controlled = true,
+    .supply_voltage           = SX126X_TCXO_CTRL_1_8V,
+    .startup_time_in_tick     = 300,
+};
+
+/**
+ * @brief Board capabilities (power at the antenna connector)
+ */
+const smtc_shield_sx126x_capabilities_t heltec_wifi_lora_32_v4_capabilities = {
+    .freq_hz_min   = SMTC_SHIELD_SX126X_FREQ_MIN,
+    .freq_hz_max   = SMTC_SHIELD_SX126X_FREQ_MAX,
+    .power_dbm_min = HELTEC_V4_PWR_MIN,
+    .power_dbm_max = HELTEC_V4_PWR_MAX,
+};
+
+/*
+ * -----------------------------------------------------------------------------
+ * --- PRIVATE VARIABLES -------------------------------------------------------
+ */
+
+static heltec_v4_fem_type_t fem_type = HELTEC_V4_FEM_UNKNOWN;
+
+/*
+ * -----------------------------------------------------------------------------
+ * --- PUBLIC FUNCTIONS DEFINITION ---------------------------------------------
+ */
+
+const smtc_shield_sx126x_pa_pwr_cfg_t* heltec_wifi_lora_32_v4_get_pa_pwr_cfg( const uint32_t rf_freq_in_hz,
+                                                                             int8_t expected_output_pwr_in_dbm )
+{
+    int8_t chip_pwr_in_dbm = expected_output_pwr_in_dbm - FEM_PA_GAIN_DB;
+
+    if( chip_pwr_in_dbm < SMTC_SHIELD_SX1262_MIN_PWR )
+    {
+        chip_pwr_in_dbm = SMTC_SHIELD_SX1262_MIN_PWR;
+    }
+    if( chip_pwr_in_dbm > ( HELTEC_V4_PWR_MAX - FEM_PA_GAIN_DB ) )
+    {
+        chip_pwr_in_dbm = HELTEC_V4_PWR_MAX - FEM_PA_GAIN_DB;
+    }
+
+    return smtc_shield_sx1262mb1das_get_pa_pwr_cfg( rf_freq_in_hz, chip_pwr_in_dbm );
+}
+
+const smtc_shield_sx126x_xosc_cfg_t* heltec_wifi_lora_32_v4_get_xosc_cfg( void )
+{
+    return &heltec_wifi_lora_32_v4_xosc_cfg;
+}
+
+const smtc_shield_sx126x_capabilities_t* heltec_wifi_lora_32_v4_get_capabilities( void )
+{
+    return &heltec_wifi_lora_32_v4_capabilities;
+}
+
+heltec_v4_fem_type_t heltec_wifi_lora_32_v4_board_init( void )
+{
+    /* FEM LDO on (the Vext rail is powered by the application at startup) */
+    gpio_reset_pin( FEM_POWER_GPIO );
+    gpio_set_direction( FEM_POWER_GPIO, GPIO_MODE_OUTPUT );
+    gpio_set_level( FEM_POWER_GPIO, 1 );
+    esp_rom_delay_us( 1000 );
+
+    /* Detect the FEM: the KCT8103L pulls its CSD line high, the GC1109 leaves its EN line low */
+    gpio_reset_pin( FEM_ENABLE_GPIO );
+    gpio_set_direction( FEM_ENABLE_GPIO, GPIO_MODE_INPUT );
+    gpio_set_pull_mode( FEM_ENABLE_GPIO, GPIO_FLOATING );
+    esp_rom_delay_us( 100 );
+    fem_type = ( gpio_get_level( FEM_ENABLE_GPIO ) == 1 ) ? HELTEC_V4_FEM_KCT8103L : HELTEC_V4_FEM_GC1109;
+
+    /* FEM enabled */
+    gpio_set_direction( FEM_ENABLE_GPIO, GPIO_MODE_OUTPUT );
+    gpio_set_level( FEM_ENABLE_GPIO, 1 );
+
+    if( fem_type == HELTEC_V4_FEM_GC1109 )
+    {
+        gpio_reset_pin( GC1109_CPS_GPIO );
+        gpio_set_direction( GC1109_CPS_GPIO, GPIO_MODE_OUTPUT );
+        ESP_LOGI( TAG_HELTEC_V4, "FEM detected: GC1109 (hardware v4.2)" );
+    }
+    else
+    {
+        gpio_reset_pin( KCT8103L_CTX_GPIO );
+        gpio_set_direction( KCT8103L_CTX_GPIO, GPIO_MODE_OUTPUT );
+        ESP_LOGI( TAG_HELTEC_V4, "FEM detected: KCT8103L (hardware v4.3)" );
+    }
+
+    heltec_wifi_lora_32_v4_fem_set_tx( false );
+
+    return fem_type;
+}
+
+void heltec_wifi_lora_32_v4_fem_set_tx( bool tx )
+{
+    if( fem_type == HELTEC_V4_FEM_GC1109 )
+    {
+        gpio_set_level( GC1109_CPS_GPIO, ( tx == true ) ? 1 : 0 );
+    }
+    else if( fem_type == HELTEC_V4_FEM_KCT8103L )
+    {
+        /* RX through the LNA */
+        gpio_set_level( KCT8103L_CTX_GPIO, ( tx == true ) ? 1 : 0 );
+    }
+}
+
+/* --- EOF ------------------------------------------------------------------ */
diff --git a/components/smtc_ral/bsp/sx126x/heltec_wifi_lora_32_v4.h b/components/smtc_ral/bsp/sx126x/heltec_wifi_lora_32_v4.h
new file mode 100644
index 0000000..47cba84
--- /dev/null
+++ b/components/smtc_ral/bsp/sx126x/heltec_wifi_lora_32_v4.h
@@ -0,0 +1,124 @@
+/*!
+ * @file      heltec_wifi_lora_32_v4.h
+ *
+ * @brief     Interface specific to Heltec WiFi LoRa 32 v4 board.
+ *              Same radio wiring as the v3 board, plus an RF front-end module (FEM) between the
+ *              sx1262 and the antenna: GC1109 on hardware v4.2, KCT8103L on hardware v4.3.
+ *
+ * The Clear BSD License
+ * Copyright Semtech Corporation 2022. All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted (subject to the limitations in the disclaimer
+ * below) provided that the following conditions are met:
+ *     * Redistributions of source code must retain the above copyright
+ *       notice, this list of conditions and the following disclaimer.
+ *     * Redistributions in binary form must reproduce the above copyright
+ *       notice, this list of conditions and the following disclaimer in the
+ *       documentation and/or other materials provided with the distribution.
+ *     * Neither the name of the Semtech corporation nor the
+ *       names of its contributors may be used to endorse or promote products
+ *       derived from this software without specific prior written permission.
+ *
+ * NO EXPRESS OR IMPLIED LICENSES TO ANY PARTY'S PATENT RIGHTS ARE GRANTED BY
+ * THIS LICENSE. THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND
+ * CONTRIBUTORS "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT
+ * NOT LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A
+ * PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL SEMTECH CORPORATION BE
+ * LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+#ifndef HELTEC_WIFI_LORA_32_V4_H
+#define HELTEC_WIFI_LORA_32_V4_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * -----------------------------------------------------------------------------
+ * --- DEPENDENCIES ------------------------------------------------------------
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "smtc_shield_sx126x_types.h"
+#include "heltec_wifi_lora_32_v3.h"
+
+/*
+ * -----------------------------------------------------------------------------
+ * --- PUBLIC MACROS -----------------------------------------------------------
+ */
+
+/* Radio pinout, RF switch and regulator are the same as the v3 board */
+#define HELTEC_WIFI_LORA_32_V4_INSTANTIATE                                         \
+    {                                                                              \
+        .get_pa_pwr_cfg           = heltec_wifi_lora_32_v4_get_pa_pwr_cfg,         \
+        .is_dio2_set_as_rf_switch = smtc_shield_sx1262mb1das_is_dio2_set_as_rf_switch, \
+        .get_reg_mode             = smtc_shield_sx1262mb1das_get_reg_mode,         \
+        .get_xosc_cfg             = heltec_wifi_lora_32_v4_get_xosc_cfg,           \
+        .get_pinout               = smtc_shield_sx1262mb1das_get_pinout,           \
+        .get_capabilities         = heltec_wifi_lora_32_v4_get_capabilities,       \
+    }
+
+/*
+ * -----------------------------------------------------------------------------
+ * --- PUBLIC CONSTANTS --------------------------------------------------------
+ */
+
+/*
+ * -----------------------------------------------------------------------------
+ * --- PUBLIC TYPES ------------------------------------------------------------
+ */
+
+typedef enum
+{
+    HELTEC_V4_FEM_UNKNOWN,
+    HELTEC_V4_FEM_GC1109,   /* hardware v4.2 */
+    HELTEC_V4_FEM_KCT8103L, /* hardware v4.3 */
+} heltec_v4_fem_type_t;
+
+/*
+ * -----------------------------------------------------------------------------
+ * --- PUBLIC FUNCTIONS PROTOTYPES ---------------------------------------------
+ */
+
+/**
+ * @see smtc_shield_sx126x_get_pa_pwr_cfg
+ * The expected output power is the power at the antenna connector, after the FEM.
+ */
+const smtc_shield_sx126x_pa_pwr_cfg_t* heltec_wifi_lora_32_v4_get_pa_pwr_cfg( const uint32_t rf_freq_in_hz,
+                                                                             int8_t expected_output_pwr_in_dbm );
+
+/**
+ * @see smtc_shield_sx126x_get_xosc_cfg
+ */
+const smtc_shield_sx126x_xosc_cfg_t* heltec_wifi_lora_32_v4_get_xosc_cfg( void );
+
+/**
+ * @see smtc_shield_sx126x_get_capabilities
+ */
+const smtc_shield_sx126x_capabilities_t* heltec_wifi_lora_32_v4_get_capabilities( void );
+
+/**
+ * @brief Power the FEM, detect its type and put it in RX mode
+ *
+ * @returns The FEM type detected
+ */
+heltec_v4_fem_type_t heltec_wifi_lora_32_v4_board_init( void );
+
+/**
+ * @brief Switch the FEM between TX (PA enabled) and RX (LNA enabled) modes
+ */
+void heltec_wifi_lora_32_v4_fem_set_tx( bool tx );
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // HELTEC_WIFI_LORA_32_V4_H
